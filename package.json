{
  "name": "visuvate-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/admin-index.mjs",
    "dev": "node server/index.mjs",
    "dev:vite": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "node scripts/admin-index.mjs",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "start": "node server/index.mjs --prod",
    "start:env": "node --env-file=.env server/index.mjs --prod",
    "preview": "vite build && node server/index.mjs --prod",
    "lint": "tsc --noEmit",
    "test:e2e": "node tests/admin-e2e.mjs",
    "test:seo": "node tests/seo-check.mjs",
    "test:privacy": "node tests/privacy-check.mjs",
    "test:launch": "node tests/launch-check.mjs",
    "test:ai": "node tests/ai-check.mjs","test:ai-eval": "node tests/ai-eval.mjs",
    "test:ai-live": "node tests/ai-live.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "compression": "^1.8.1",
    "countries-and-timezones": "^3.10.0",
    "express": "^5.3.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "nodemailer": "^10.1.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.64.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.0"
  }
}
