{
  "name": "esa-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "user:admin": "node --env-file-if-exists=.env --import tsx server/scripts/create-admin.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^7.0.1",
    "@tanstack/react-query": "^5.105.1",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.66.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
