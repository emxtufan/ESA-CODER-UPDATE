{
  "name": "esa-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "user:admin": "node --env-file-if-exists=.env --import tsx server/scripts/create-admin.ts"
  }
}
