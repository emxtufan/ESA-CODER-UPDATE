# ESA Management — exemplu de configurare. Copiază în .env și completează valorile.
# Nu commita .env. Neconfigurat = afișat explicit "neconectat" în interfață.

# --- Aplicație ---
NODE_ENV=development
HOST=127.0.0.1
PORT=5100
# URL public al aplicației (folosit la linkuri din emailuri și la cookie/CORS)
APP_URL=http://127.0.0.1:5100

# --- Bază de date ---
# Gol = PGlite local în DATA_DIR/pg (dev/test). În prod: postgres://user:parola@host:5432/db
DATABASE_URL=
# Director pentru date locale (PGlite, documente, upload-uri)
DATA_DIR=data

# --- Criptare / semnare ---
# Cheie master AES-256-GCM pentru Vault: exact 64 caractere hex (32 bytes)
# Generare: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_MASTER_KEY=
# Cheie pentru linkuri temporare semnate (documente): exact 64 caractere hex (32 bytes)
FILE_SIGNING_KEY=

# --- Email (SMTP) ---
SMTP_HOST=
# 587 = STARTTLS, 465 = TLS direct
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Expeditor, ex: "ESA Management <no-reply@domeniu.ro>"
EMAIL_FROM=

# --- GitHub (API + webhooks) ---
GITHUB_TOKEN=
# Secretul din Setările webhook-ului; folosit la verificarea HMAC SHA-256 pe raw body
GITHUB_WEBHOOK_SECRET=

# --- Storage S3-compatible (opțional; altfel storage local în DATA_DIR) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
