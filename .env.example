# Copiază în .env numai pe server; nu publica fișierul și nu îl pune în Git.
# Pornire: npm run start:env. Alternativ, definește variabilele în hosting și folosește npm start.
NODE_ENV=production
HOST=127.0.0.1
PORT=5000
SITE_URL=https://esa-coder-solutions.com
# Setează o parolă unică; dacă lipsește, serverul o generează în data/admin-password.txt.
ADMIN_PASSWORD=

# Aceste fișiere trebuie să fie pe un disc persistent, în afara directorului web public.
# Valorile relative sunt rezolvate față de directorul proiectului.
# La prima instalare, copiază source_data.json la CONTENT_FILE dacă alegi o cale externă.
CONTENT_FILE=source_data.json
CONTACTS_FILE=data/contacts.json
ANALYTICS_FILE=data/analytics.json
SMTP_FILE=data/smtp.json
RECAPTCHA_FILE=data/recaptcha.json
IMAGE_CACHE_DIR=data/image-cache

# GDPR private registry, integrity key and optional encrypted snapshots.
# Keep this directory outside public/ and back it up separately from personal-data snapshots.
GDPR_DIR=data/gdpr
# Optional: a cryptographically random 32-byte key encoded as 64 hexadecimal characters.
# Store outside backups; losing it makes encrypted snapshots unreadable. Never commit a real key.
GDPR_BACKUP_KEY=

# AI assistant
# Optional: 64 hex characters. Generate with
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_SECRET_KEY=
# Where the assistant keeps providers, conversations and its knowledge base (outside the web root).
AI_DIR=data/ai
# Optional: host:port allowed for a local Ollama, e.g. 127.0.0.1:11434.
AI_PRIVATE_HOSTS=
